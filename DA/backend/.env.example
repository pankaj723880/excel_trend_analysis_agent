# Gemini API keys - supports single GEMINI_API_KEY, comma-separated GEMINI_API_KEYS, or 10+ indexed keys (GEMINI_API_KEY_1 to GEMINI_API_KEY_10)
# If one API key fails (due to quota, 429 rate limit, or invalid key), the backend automatically falls back to the next working key.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/excel_intelligence?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=excel_intelligence

# Storage directory for uploaded workbooks (defaults to a temp folder inside backend/)
UPLOAD_DIR=

# CORS origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,https://agent-6ab00e97922598066035110--exceltrendanalyst.netlify.app

# Gemini model to use for AI agent
GEMINI_MODEL=gemini-2.5-flash
